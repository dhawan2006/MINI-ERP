# ---------------------------------------------------------------------------
# Server-Side Configuration (Supabase Edge Secrets)
#
# DO NOT include real production secrets in QA or source control.
# ---------------------------------------------------------------------------

# Port or generic info
NODE_ENV=development

# Network
# PORT is handled by Supabase, generally not needed.

# Database
# In Supabase Edge Functions, Supabase manages DATABASE_URL automatically.
# However, you can use SUPABASE_DB_URL or reference the connection pooler URL.
# DATABASE_URL=

# Admin Authentication
# Must be at least 64 characters in production.
ADMIN_API_TOKEN=

# License key HMAC secret
# Must be at least 64 characters in production.
LICENSE_KEY_HMAC_SECRET=

# Server Authorization Signing Key
# Must be an Ed25519 PEM string (at least 64 chars).
LICENSING_SERVER_PRIVATE_KEY=

# The stable Key ID (kid) for the current signing key.
LICENSING_SERVER_KEY_ID=

# CORS — comma-separated list of allowed origins.
ALLOWED_ORIGINS=
