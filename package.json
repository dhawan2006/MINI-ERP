{
  "name": "mini-erp",
  "productName": "Mini POS",
  "appId": "com.minipos.app",
  "version": "1.0.0",
  "description": "",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:qa": "LICENSING_SERVER_URL=http://localhost:3456 LICENSING_SERVER_KEY_ID=qa-key-1 LICENSING_SERVER_PUBLIC_KEY=\"$(cat .local-qa/signing/qa-public-key.pem)\" vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:mac:arm64": "node scripts/prebuild-check.js && npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "node scripts/prebuild-check.js && npm run build && electron-builder --mac --x64",
    "package:mac:universal": "node scripts/prebuild-check.js && npm run build && electron-builder --mac --universal",
    "package:win:x64": "node scripts/prebuild-check.js && npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "jsdom": "^30.0.1",
    "pdf2json": "^4.0.3",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  }
