# =============================================================================
# .env.example — Mini POS Licensing Server
# Development / Test environment template
#
# Copy this file to .env and fill in values for local development.
# DO NOT commit .env to version control.
# =============================================================================

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# For local development:
DATABASE_URL=postgres://localhost:5432/minipos_licensing_dev

# Test DB (used by automated tests):
# DATABASE_URL=postgres://localhost:5432/minipos_licensing_test

# ─── Admin Authentication ────────────────────────────────────────────────────
# Minimum 32 characters for development, 64 for production.
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN=dev-replace-this-with-32-char-minimum-value!!

# ─── License Key HMAC Secret ─────────────────────────────────────────────────
# Used to one-way hash license keys before DB storage.
# Generate: openssl rand -hex 32
LICENSE_KEY_HMAC_SECRET=dev-replace-this-with-32-char-minimum-value!!

# ─── Server Authorization Signing Key ────────────────────────────────────────
# Ed25519 private key in PKCS#8 PEM format (base64-collapsed for env var).
# Generate:
#   openssl genpkey -algorithm ed25519 -out server-signing.pem
#   cat server-signing.pem  (paste the full PEM here, including headers)
#
# WARNING: NEVER use the same key in development and production.
# WARNING: NEVER commit a real key to this file.
LICENSING_SERVER_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nDEV_PLACEHOLDER_REPLACE_WITH_ACTUAL_KEY\n-----END PRIVATE KEY-----

# The Key ID (kid) embedded in every issued authorization.
# Must match the kid registered in the Electron client's trusted key set.
LICENSING_SERVER_KEY_ID=dev-key-1

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Leave blank in development to allow all origins.
# ALLOWED_ORIGINS=https://admin.example.com
