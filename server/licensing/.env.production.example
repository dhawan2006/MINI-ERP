# =============================================================================
# .env.production.example — Mini POS Licensing Server
# Production environment template
#
# DO NOT commit .env.production to version control.
# =============================================================================

NODE_ENV=production
PORT=3000

# Must point to an external PostgreSQL instance (not localhost).
DATABASE_URL=postgres://user:password@production-db-host:5432/minipos_licensing

# Minimum 64 characters. Generate: openssl rand -hex 64
ADMIN_API_TOKEN=prod-replace-this-with-64-char-minimum-value!!

# Minimum 64 characters. Generate: openssl rand -hex 64
LICENSE_KEY_HMAC_SECRET=prod-replace-this-with-64-char-minimum-value!!

# Production Ed25519 private key in PKCS#8 PEM format.
# Ensure this matches the public key embedded in the Electron client!
LICENSING_SERVER_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nPROD_PLACEHOLDER_REPLACE_WITH_ACTUAL_KEY\n-----END PRIVATE KEY-----

# The Key ID for the production signing key.
LICENSING_SERVER_KEY_ID=prod-key-1

# Restrict CORS to allowed domains.
ALLOWED_ORIGINS=https://admin.yourdomain.com
